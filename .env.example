# Copy to .env (never commit it). All paths are read from the environment.
STORAGE_ROOT=./storage
ENTSOE_RAW_DIR=/path/to/raw/xml
# Either export the token directly or point to an env file that defines it.
# ENTSOE_API_TOKEN=
# ENTSOE_ENV_FILE=/path/to/file/with/ENTSOE_API_TOKEN
THREADS=4
